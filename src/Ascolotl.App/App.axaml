<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cc="using:AvaloniaEdit.CodeCompletion"
             x:Class="Ascolotl.App.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <!-- Dark theme colors -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Fluent system accent: Ascolotl rose -->
                    <Color x:Key="SystemAccentColor">#E8608A</Color>
                    <Color x:Key="SystemAccentColorDark1">#C4406A</Color>
                    <Color x:Key="SystemAccentColorDark2">#A03355</Color>
                    <Color x:Key="SystemAccentColorDark3">#802845</Color>
                    <Color x:Key="SystemAccentColorLight1">#F0889E</Color>
                    <Color x:Key="SystemAccentColorLight2">#F5A0B2</Color>
                    <Color x:Key="SystemAccentColorLight3">#F8B8C6</Color>

                    <SolidColorBrush x:Key="ForgeAccentBrush" Color="#E8608A" />
                    <SolidColorBrush x:Key="ForgeAccentDarkBrush" Color="#C4406A" />
                    <SolidColorBrush x:Key="ForgeAccentLightBrush" Color="#4A2535" />
                    <SolidColorBrush x:Key="ForgeAccentSubtleBrush" Color="#26E8608A" />
                    <SolidColorBrush x:Key="ForgeAccentTextBrush" Color="#F0889E" />
                    <SolidColorBrush x:Key="ForgeBgDeepBrush" Color="#161413" />
                    <SolidColorBrush x:Key="ForgeBgBrush" Color="#1F1D1B" />
                    <SolidColorBrush x:Key="ForgeBgSurfaceBrush" Color="#262321" />
                    <SolidColorBrush x:Key="ForgeBorderBrush" Color="#34302C" />
                    <SolidColorBrush x:Key="ForgeTextBrush" Color="#F5F2EE" />
                    <SolidColorBrush x:Key="ForgeTextMutedBrush" Color="#B2ABA4" />
                    <SolidColorBrush x:Key="ForgeTabTextBrush" Color="#D7D1CB" />
                    <!-- Title bar: one step off the editor surface, warm neutral. -->
                    <SolidColorBrush x:Key="ForgeTitleBarBrush" Color="#191715" />
                    <SolidColorBrush x:Key="ForgeHighlightBrush" Color="#12FFFFFF" />
                    <!-- Tabs fade between these, so they're opaque: a fade to a
                         see-through colour passes through grey. Idle = title bar;
                         hover = the highlight laid over it. -->
                    <SolidColorBrush x:Key="ForgeTabIdleBrush" Color="#191715" />
                    <SolidColorBrush x:Key="ForgeTabHoverBrush" Color="#292725" />

                    <!-- Menu dropdowns: retheme Fluent's default gray flyout surface,
                         text, hover, submenu chevron and separators to the Forge palette. -->
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#262321" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#34302C" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#302C29" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#302C29" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#F5F2EE" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#F5F2EE" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#F5F2EE" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#7F7973" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#968F88" />
                    <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="#968F88" />
                    <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#34302C" />
                    <SolidColorBrush x:Key="MenuBarItemBackgroundPointerOver" Color="#262321" />
                    <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="#262321" />
                    <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="#262321" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Fluent system accent: Ascolotl rose -->
                    <Color x:Key="SystemAccentColor">#D94F7A</Color>
                    <Color x:Key="SystemAccentColorDark1">#B03A5E</Color>
                    <Color x:Key="SystemAccentColorDark2">#8C2D4A</Color>
                    <Color x:Key="SystemAccentColorDark3">#6E2238</Color>
                    <Color x:Key="SystemAccentColorLight1">#E87A98</Color>
                    <Color x:Key="SystemAccentColorLight2">#F5D0DC</Color>
                    <Color x:Key="SystemAccentColorLight3">#F8E0E8</Color>

                    <SolidColorBrush x:Key="ForgeAccentBrush" Color="#D94F7A" />
                    <SolidColorBrush x:Key="ForgeAccentDarkBrush" Color="#B03A5E" />
                    <SolidColorBrush x:Key="ForgeAccentLightBrush" Color="#F7DCE5" />
                    <SolidColorBrush x:Key="ForgeAccentSubtleBrush" Color="#1FD94F7A" />
                    <SolidColorBrush x:Key="ForgeAccentTextBrush" Color="#C2416C" />
                    <SolidColorBrush x:Key="ForgeBgDeepBrush" Color="#ECE9E3" />
                    <SolidColorBrush x:Key="ForgeBgBrush" Color="#FBFAF8" />
                    <SolidColorBrush x:Key="ForgeBgSurfaceBrush" Color="#F4F2EE" />
                    <SolidColorBrush x:Key="ForgeBorderBrush" Color="#E5E1DA" />
                    <SolidColorBrush x:Key="ForgeTextBrush" Color="#24221F" />
                    <SolidColorBrush x:Key="ForgeTextMutedBrush" Color="#6B6761" />
                    <SolidColorBrush x:Key="ForgeTabTextBrush" Color="#3E3B36" />
                    <!-- Title bar: one step off the editor surface, warm neutral. -->
                    <SolidColorBrush x:Key="ForgeTitleBarBrush" Color="#F4F2EE" />
                    <SolidColorBrush x:Key="ForgeHighlightBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="ForgeTabIdleBrush" Color="#F4F2EE" />
                    <SolidColorBrush x:Key="ForgeTabHoverBrush" Color="#EAE8E4" />

                    <!-- Menu dropdowns: retheme Fluent's default gray flyout surface,
                         text, hover, submenu chevron and separators to the Forge palette. -->
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FDFCFA" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#E5E1DA" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#F1EEE9" />
                    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#F1EEE9" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#24221F" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#24221F" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#24221F" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#A29E97" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#8F8B84" />
                    <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="#8F8B84" />
                    <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#ECE9E3" />
                    <SolidColorBrush x:Key="MenuBarItemBackgroundPointerOver" Color="#ECE9E3" />
                    <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="#ECE9E3" />
                    <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="#ECE9E3" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ── Icon geometries (theme-independent): one consistent outline set,
                 stroked via Path.icon. Replaces ad-hoc unicode glyphs. ── -->
            <StreamGeometry x:Key="IconMenuGeometry">M5 7.5 H19 M5 12 H19 M5 16.5 H19</StreamGeometry>
            <StreamGeometry x:Key="IconChevronDownGeometry">M6 9 L12 15 L18 9</StreamGeometry>
            <StreamGeometry x:Key="IconCloseGeometry">M6 6 L18 18 M18 6 L6 18</StreamGeometry>
            <StreamGeometry x:Key="IconWarningGeometry">M12 3 L22 21 H2 Z M12 9 V14 M12 17.3 v0.2</StreamGeometry>
            <StreamGeometry x:Key="IconErrorGeometry">M3 12 A9 9 0 1 1 21 12 A9 9 0 1 1 3 12 Z M8 8 L16 16 M16 8 L8 16</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- Outline icon glyphs: consistent stroke + caps; size via Width/Height. -->
        <Style Selector="Path.icon">
            <Setter Property="Stroke" Value="{DynamicResource ForgeTextMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <!-- Consistent keyboard focus ring on buttons (accent). -->
        <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource ForgeAccentTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- ── Tabs: flat, top-rounded, standing on the title bar's bottom edge.
             The active one takes the editor's surface so it flows into the
             editor; rose is kept for the unsaved dot. Motion ~140ms. ── -->
        <Style Selector="TabStrip">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabStripItem">
            <Setter Property="Foreground" Value="{DynamicResource ForgeTabTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ForgeTabIdleBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,0,8,1" />
            <Setter Property="Height" Value="25" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MaxWidth" Value="240" />
            <Setter Property="Margin" Value="0,5,1,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <!-- Custom template: drops the Fluent "selected pipe"; the state
                 setters drive the look. -->
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7,7,0,0"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Keyboard focus ring (the custom template above dropped Fluent's).
             :focus-visible only triggers for keyboard focus, not mouse. -->
        <Style Selector="TabStripItem:focus-visible /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TabStripItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ForgeTabHoverBrush}" />
        </Style>
        <Style Selector="TabStripItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ForgeBgBrush}" />
        </Style>

        <!-- Per-tab close button + modified dot: dot shows when dirty, the
             close ✕ fades in on hover and takes the dot's place. -->
        <Style Selector="Button.close-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeTabTextBrush}" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TabStripItem:pointerover Button.close-tab, TabStripItem:selected Button.close-tab">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Panel.dirty Button.close-tab">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="TabStripItem:pointerover Panel.dirty Button.close-tab">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.close-tab:pointerover">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ForgeAccentLightBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextBrush}" />
        </Style>
        <Style Selector="Ellipse.modified-dot">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TabStripItem:pointerover Ellipse.modified-dot">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Tab overflow: lists every open document when the tabs don't fit. -->
        <Style Selector="Button.all-tabs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.all-tabs:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ForgeHighlightBrush}" />
        </Style>

        <!-- ── Formatting toolbar: quiet icon buttons, hairline separators ── -->
        <Style Selector="Button.format">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.format:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ForgeHighlightBrush}" />
        </Style>
        <Style Selector="Button.format:pointerover Path.icon">
            <Setter Property="Stroke" Value="{DynamicResource ForgeTextBrush}" />
        </Style>
        <!-- About box links: accent text, no chrome. -->
        <Style Selector="HyperlinkButton.about">
            <Setter Property="Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,18,0" />
        </Style>
        <!-- Apply / Cancel of an in-place edit, at the toolbar's right end. -->
        <Style Selector="Button.format-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.format-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ForgeHighlightBrush}" />
        </Style>
        <Style Selector="Button.format-action.apply">
            <Setter Property="Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- The toolbar's view switch: quiet words, the current view in accent. -->
        <Style Selector="Button.view">
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextMutedBrush}" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="Button.view.active">
            <Setter Property="Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
        </Style>
        <Style Selector="Button.view.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ForgeHighlightBrush}" />
        </Style>
        <Style Selector="Border.format-separator">
            <Setter Property="Background" Value="{DynamicResource ForgeBorderBrush}" />
        </Style>

        <!-- ── Outline sidebar: tight rows, full-row hover, accent active ── -->
        <Style Selector="ListBox.outline">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.outline ListBoxItem">
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextMutedBrush}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBox.outline ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ForgeBgSurfaceBrush}" />
        </Style>
        <Style Selector="ListBox.outline ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource ForgeAccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForgeAccentBrush}" />
        </Style>
        <Style Selector="ListBox.outline ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
        </Style>

        <!-- File tree rows as tall as the outline's (Fluent's are 32px). -->
        <Style Selector="TreeView#ProjectTree TreeViewItem">
            <Setter Property="MinHeight" Value="25" />
        </Style>

        <!-- ── Thin, low-contrast scrollbars; accent on hover ── -->
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource ForgeBorderBrush}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource ForgeAccentBrush}" />
        </Style>

        <!-- Top-level menus (now hosted in the title bar): flat + compact -->
        <Style Selector="Menu">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Compact menu text (top-level + all submenu items). The ☰ glyph
             keeps its own larger inline FontSize. -->
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="12" />
            <!-- Dropdown rows a little tighter than Fluent's 4/7. -->
            <Setter Property="Padding" Value="11,3,11,5" />
        </Style>
        <!-- After the MenuItem style: of two matching styles the later wins, so
             the menu bar's items keep their own padding. Its text sits 2px low,
             on the same line as the tabs' text (the tabs hang from the bottom of
             the title bar). -->
        <Style Selector="Menu > MenuItem">
            <Setter Property="Padding" Value="9,6,9,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextBrush}" />
        </Style>
        <Style Selector="Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ForgeHighlightBrush}" />
        </Style>
        <Style Selector="Menu > MenuItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
        </Style>

        <!-- Menu toggle glyphs: pink check/radio indicators.
             Fluent template glyphs bind Fill to $parent[MenuItem].Foreground
             (a local binding that beats style setters on the glyph itself).
             The only way to color the glyph is to set Foreground on MenuItem. -->
        <Style Selector="MenuItem:checked">
            <Setter Property="Foreground" Value="{DynamicResource ForgeAccentBrush}" />
        </Style>

        <!-- Menu dropdown popups: rounded + padded; surface/text/chevron colours
             come from the MenuFlyout* resource overrides in the theme dictionaries. -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <!-- ── Modal dialog action buttons: centered text, compact padding,
             consistent font; the default action carries the pink accent ── -->
        <Style Selector="Button.dialog">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource ForgeBgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForgeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextBrush}" />
        </Style>
        <Style Selector="Button.dialog /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.dialog:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ForgeBgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForgeAccentDarkBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextBrush}" />
        </Style>
        <Style Selector="Button.dialog.primary">
            <Setter Property="Background" Value="{DynamicResource ForgeAccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.dialog.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ForgeAccentDarkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForgeAccentDarkBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Splitter: thin hairline, accent on hover -->
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource ForgeBorderBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource ForgeAccentLightBrush}" />
        </Style>

        <!-- Authoring-assist completion popup: match the Forge palette instead
             of AvaloniaEdit's default gray. -->
        <Style Selector="cc|CompletionList">
            <Setter Property="Background" Value="{DynamicResource ForgeBgSurfaceBrush}" />
        </Style>
        <Style Selector="cc|CompletionListBox">
            <Setter Property="Background" Value="{DynamicResource ForgeBgSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ForgeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="cc|CompletionListBox ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="cc|CompletionListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ForgeHighlightBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextBrush}" />
        </Style>
        <Style Selector="cc|CompletionListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ForgeAccentSubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForgeTextBrush}" />
        </Style>
    </Application.Styles>

</Application>
