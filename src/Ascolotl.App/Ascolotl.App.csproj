<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Ascolotl.App</RootNamespace>
    <ApplicationIcon Condition="Exists('Resources\app.ico')">Resources\app.ico</ApplicationIcon>
    <AssemblyName>Ascolotl</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Ascolotl</Product>
    <Copyright>Copyright (C) 2026 Sylvain Fasel</Copyright>
    <Description>AsciiDoc source editor with live preview and PDF export</Description>
    <!-- Settings and recovery files use reflection-based System.Text.Json, which a
         trimmed publish disables by default (settings would silently reset). -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="AdocNet.Avalonia" Version="1.0.47" />
    <PackageReference Include="AdocNet.Layout" Version="1.0.47" />
    <!-- SVG title-page images (logos, backgrounds) in the styled preview. -->
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="11.3.9.5" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Security override: Avalonia's Linux/X11 backend pulls Tmds.DBus.Protocol 0.21.2,
         which has GHSA-xrw6-gwf8-vvr9 (CVE-2026-39959). Pin the patched 0.21.3 (same
         line, no API drift). D-Bus is Linux-only, so this is inert on the Windows build. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
</ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\JetBrainsMono-Regular.ttf" />
    <AvaloniaResource Include="Assets\app-icon.png" />
    <!-- The window's icon: an image per size, as the exe's, so the taskbar's isn't shrunk from 256 px. -->
    <AvaloniaResource Include="Resources\app.ico" />
    <!-- Licenses: shown from the About box, and beside the app in every download. -->
    <AvaloniaResource Include="..\..\THIRD-PARTY-NOTICES.txt" Link="Assets\THIRD-PARTY-NOTICES.txt" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- .txt: opens on a double-click, and the archive keeps extensionless files for the app. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ascolotl.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ascolotl.Core\Ascolotl.Core.csproj" />
    <ProjectReference Include="..\Ascolotl.Infrastructure\Ascolotl.Infrastructure.csproj" />
    <ProjectReference Include="..\Ascolotl.Export\Ascolotl.Export.csproj" />
  </ItemGroup>

</Project>
