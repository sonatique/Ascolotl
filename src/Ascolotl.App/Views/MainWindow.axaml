<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Ascolotl.Core.Resources"
        xmlns:vm="using:Ascolotl.Core.ViewModels"
        xmlns:models="using:Ascolotl.Core.Models"
        xmlns:assist="using:Ascolotl.Core.Editing.Assist"
        xmlns:views="using:Ascolotl.App.Views"
        xmlns:converters="using:Ascolotl.App.Converters"
        x:Class="Ascolotl.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static res:Strings.Ascolotl}"
        Width="1280" Height="800"
        MinWidth="600" MinHeight="400"
        DragDrop.AllowDrop="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        Background="{DynamicResource ForgeBgBrush}">

    <Window.Resources>
        <converters:LevelToMarginConverter x:Key="LevelToMarginConverter" />
    </Window.Resources>

    <!-- Root Panel for z-order (command palette floats on top) -->
    <Panel>
        <!-- OffScreenMargin compensates the resize border that goes off-screen
             when maximized, so the title bar isn't clipped at the top (which made
             its items look top-biased with extra space below). -->
        <DockPanel x:Name="ContentDockPanel"
                   Margin="{Binding $parent[Window].OffScreenMargin}">
            <!-- Segmented status bar -->
            <Border DockPanel.Dock="Bottom"
                    Height="24"
                    Background="{DynamicResource ForgeBgDeepBrush}"
                    BorderBrush="{DynamicResource ForgeBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ForgeTextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <!-- Authoring-assist syntax hint for the caret context. -->
                        <TextBlock Text="{Binding SelectedDocument.SyntaxHint}"
                                   IsVisible="{Binding SelectedDocument.HasSyntaxHint}"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource ForgeTextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <!-- Parser diagnostics count (errors / warnings); hover
                             for the messages. -->
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    IsVisible="{Binding SelectedDocument.HasErrors, FallbackValue=False}"
                                    ToolTip.Tip="{Binding SelectedDocument.DiagnosticsSummary}"
                                    VerticalAlignment="Center">
                            <Path Classes="icon" Data="{StaticResource IconErrorGeometry}"
                                  Width="13" Height="13" Stroke="#C0241F" />
                            <TextBlock Text="{Binding SelectedDocument.ErrorCount}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#C0241F"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    IsVisible="{Binding SelectedDocument.HasWarnings, FallbackValue=False}"
                                    ToolTip.Tip="{Binding SelectedDocument.DiagnosticsSummary}"
                                    VerticalAlignment="Center">
                            <Path Classes="icon" Data="{StaticResource IconWarningGeometry}"
                                  Width="13" Height="13" Stroke="#E5322B" />
                            <TextBlock Text="{Binding SelectedDocument.WarningCount}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="#E5322B"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Right segments: spacing, not hairlines; tabular figures so
                         Ln/Col and zoom don't jitter as digits change width. -->
                    <!-- The current file's full path; trimmed from the start so the
                         file name stays visible. -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedDocument.FilePath, FallbackValue=''}"
                               ToolTip.Tip="{Binding SelectedDocument.FilePath, FallbackValue=''}"
                               TextTrimming="PrefixCharacterEllipsis"
                               FontSize="11"
                               Margin="16,0,16,0"
                               Foreground="{DynamicResource ForgeTextMutedBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                        <!-- Prose word count; reading time + characters on hover
                             (tooltip keeps the bar quiet — screen estate). -->
                        <TextBlock Text="{Binding SelectedDocument.WordCountText}"
                                   ToolTip.Tip="{Binding SelectedDocument.StatsTooltip}"
                                   FontSize="11"
                                   FontFeatures="tnum=1"
                                   Foreground="{DynamicResource ForgeTextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Name="EditorModeText"
                                   Text="{x:Static res:Strings.Split}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ForgeTextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Name="CursorPositionText"
                                   Text="{x:Static res:Strings.Ln1Col1}"
                                   FontSize="11"
                                   FontFeatures="tnum=1"
                                   Foreground="{DynamicResource ForgeTextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static res:Strings.UTF8}"
                                   FontSize="11"
                                   Foreground="{DynamicResource ForgeTextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Name="ZoomText"
                                   Text="100%"
                                   FontSize="11"
                                   FontFeatures="tnum=1"
                                   Foreground="{DynamicResource ForgeTextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Outer Grid: Outline + Document Area -->
            <Grid Name="OuterGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar: Outline, plus the project file tree when a folder
                     is open. The header doubles as the section switcher — two
                     quiet text tabs, no chrome (screen estate). -->
                <Border Grid.Column="0"
                        Name="OutlinePane"
                        Width="220"
                        IsVisible="{Binding ShowOutlinePane}"
                        Background="{DynamicResource ForgeBgDeepBrush}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12"
                                    Margin="14,10,12,8">
                            <TextBlock Name="SidebarOutlineTab"
                                       Text="{x:Static res:Strings.Outline}"
                                       FontSize="11"
                                       Cursor="Hand"
                                       Foreground="{DynamicResource ForgeTextMutedBrush}" />
                            <TextBlock Name="SidebarFilesTab"
                                       Text="{x:Static res:Strings.Files}"
                                       FontSize="11"
                                       Cursor="Hand"
                                       IsVisible="{Binding HasProject}"
                                       Foreground="{DynamicResource ForgeTextMutedBrush}" />
                        </StackPanel>
                        <Panel>
                            <ListBox Name="OutlineList"
                                     Classes="outline"
                                     ItemsSource="{Binding OutlineItems}"
                                     SelectionMode="Single"
                                     IsVisible="{Binding !SidebarFilesActive}"
                                     Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:OutlineItem">
                                        <TextBlock Text="{Binding Title}"
                                                   Margin="{Binding Level, Converter={StaticResource LevelToMarginConverter}}"
                                                   FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Title}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TreeView Name="ProjectTree"
                                      ItemsSource="{Binding ProjectRoots}"
                                      IsVisible="{Binding SidebarFilesActive}"
                                      SelectionMode="Single"
                                      Padding="4,0,0,0">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate ItemsSource="{Binding Children}"
                                                      x:DataType="models:ProjectNode">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding FullPath}" />
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Panel>
                    </DockPanel>
                </Border>

                <!-- Outline Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              IsVisible="{Binding ShowOutlinePane}"
                              Background="{DynamicResource ForgeBorderBrush}" />

                <!-- Document Area -->
                <DockPanel Grid.Column="2">
                    <!-- App icon + menu + tabs all share the top row (this row
                         also replaces the OS title bar). The menu is reparented
                         in code-behind between a single ☰ item (hamburger) and
                         inline File/View, driven by the HamburgerMenu setting. -->
                    <Grid DockPanel.Dock="Top"
                          Height="32"
                          Background="{DynamicResource ForgeTitleBarBrush}"
                          ColumnDefinitions="Auto,Auto,*">
                        <Image Grid.Column="0"
                               Source="avares://Ascolotl/Assets/app-icon.png"
                               Width="16" Height="16"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               VerticalAlignment="Center"
                               Margin="9,0,3,0" />
                        <Menu x:Name="MainMenu"
                              Grid.Column="1"
                              VerticalAlignment="Stretch"
                              MinHeight="0"
                              Margin="0,0,2,0">
                            <views:AppMenus x:Name="HamburgerMenuItem"
                                      VerticalAlignment="Stretch"
                                      Padding="0"
                                      MinHeight="0"
                                      ToolTip.Tip="{x:Static res:Strings.Menu}"
                                      AutomationProperties.Name="{x:Static res:Strings.MainMenuName}">
                                <MenuItem.Header>
                                    <!-- The menu item top-biases its content; position
                                         the icon with an explicit top margin (tunable). -->
                                    <Panel Width="32" Height="32">
                                        <Path Classes="icon"
                                              Data="{StaticResource IconMenuGeometry}"
                                              Width="14" Height="14"
                                              StrokeThickness="1.5"
                                              VerticalAlignment="Top"
                                              HorizontalAlignment="Center"
                                              Margin="0,11.5,0,0"
                                              Stroke="{DynamicResource ForgeTextBrush}" />
                                    </Panel>
                                </MenuItem.Header>
                            </views:AppMenus>
                            <!-- The menu-bar set is added in code (MainWindow.ApplyMenuMode). -->
                        </Menu>

                        <!-- Fill: tabs (left, horizontally scrollable when they
                             overflow) + empty draggable space (right, where the
                             OS caption buttons overlay). The ScrollViewer's right
                             margin keeps tabs clear of the caption buttons. -->
                        <Panel x:Name="TitleDragArea" Grid.Column="2" Background="Transparent">
                        <DockPanel Margin="0,0,150,0">
                        <!-- Shown when the tabs overflow: lists every open document. -->
                        <Button x:Name="AllTabsButton"
                                DockPanel.Dock="Right"
                                Classes="all-tabs"
                                IsVisible="False"
                                Margin="4,0,0,0"
                                ToolTip.Tip="{x:Static res:Strings.AllOpenDocuments}"
                                AutomationProperties.Name="{x:Static res:Strings.AllOpenDocuments}">
                            <Path Classes="icon"
                                  Data="{StaticResource IconChevronDownGeometry}"
                                  Width="12" Height="12" />
                        </Button>
                        <ScrollViewer x:Name="TabScroll"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Stretch"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                        <TabStrip ItemsSource="{Binding Documents}"
                                  SelectedItem="{Binding SelectedDocument}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom"
                                  Name="DocumentTabStrip">
                        <TabStrip.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center"
                                      ToolTip.Tip="{Binding FilePath, TargetNullValue='Not saved yet'}">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" Width="16" Height="16" Margin="8,0,0,0"
                                           Classes.dirty="{Binding IsDirty}">
                                        <Ellipse Classes="modified-dot"
                                                 Width="7" Height="7"
                                                 Fill="{DynamicResource ForgeAccentBrush}"
                                                 IsVisible="{Binding IsDirty}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                                        <Button Classes="close-tab"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                ToolTip.Tip="{x:Static res:Strings.CloseTabTooltip}"
                                                AutomationProperties.Name="{x:Static res:Strings.CloseTabTooltip}"
                                                Command="{Binding $parent[Window].DataContext.CloseDocumentCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Classes="icon"
                                                  Data="{StaticResource IconCloseGeometry}"
                                                  Width="9" Height="9"
                                                  Stroke="{Binding $parent[Button].Foreground}" />
                                        </Button>
                                    </Panel>
                                </Grid>
                            </DataTemplate>
                        </TabStrip.ItemTemplate>
                        </TabStrip>
                        </ScrollViewer>
                        </DockPanel>
                        </Panel>
                    </Grid>

                    <!-- Formatting toolbar, for the split and WYSIWYG views. -->
                    <Panel DockPanel.Dock="Top" IsVisible="{Binding !HasNoDocuments}">
                        <views:FormatToolbar x:Name="FormatBar"
                                             IsVisible="{Binding !IsSourceMode}"
                                             Markdown="{Binding SelectedDocument.IsMarkdown, FallbackValue=False}"
                                             EditOpen="{Binding InPlaceEditOpen}"
                                             Height="30"
                                             Background="{DynamicResource ForgeBgBrush}"
                                             BorderBrush="{DynamicResource ForgeBorderBrush}"
                                             BorderThickness="0,0,0,1"
                                             AutomationProperties.Name="{x:Static res:Strings.FormattingToolbar}" />
                    </Panel>

                    <!-- Content Area: Split layout -->
                    <Grid Name="ContentGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Source Editor -->
                        <ContentControl Grid.Column="0"
                                        Content="{Binding SelectedDocument}"
                                        Name="EditorPane">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:DocumentViewModel">
                                    <views:SourceEditorView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Splitter -->
                        <GridSplitter Grid.Column="1"
                                      Width="5"
                                      Name="Splitter"
                                      Background="{DynamicResource ForgeBorderBrush}" />

                        <!-- Preview Pane -->
                        <ContentControl Grid.Column="2"
                                        Content="{Binding SelectedDocument}"
                                        Name="PreviewPane">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:DocumentViewModel">
                                    <views:PreviewView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Empty state: covers the split when no document is open. -->
                        <views:EmptyStateView Grid.Column="0" Grid.ColumnSpan="3"
                                              IsVisible="{Binding HasNoDocuments}" />
                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>

        <!-- Command Palette Backdrop (click-outside-to-close) -->
        <Border Name="CommandPaletteBackdrop"
                IsVisible="{Binding CommandPalette.IsOpen}"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

        <!-- Command Palette Overlay -->
        <Border Name="CommandPaletteOverlay"
                IsVisible="{Binding CommandPalette.IsOpen}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,80,0,0"
                Width="500"
                MaxHeight="400"
                CornerRadius="12"
                Background="{DynamicResource ForgeBgSurfaceBrush}"
                BorderBrush="{DynamicResource ForgeBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 4 16 0 #40000000"
                Padding="0">
            <DockPanel>
                <TextBox Name="CommandPaletteFilter"
                         DockPanel.Dock="Top"
                         Watermark="{x:Static res:Strings.TypeACommand}"
                         Text="{Binding CommandPalette.FilterText, Mode=TwoWay}"
                         Margin="8"
                         FontSize="14" />
                <ListBox Name="CommandPaletteList"
                         ItemsSource="{Binding CommandPalette.FilteredCommands}"
                         SelectedIndex="{Binding CommandPalette.SelectedIndex, Mode=TwoWay}"
                         MaxHeight="300"
                         Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:CommandEntry">
                            <Grid ColumnDefinitions="*, Auto" Margin="8,4">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Shortcut}"
                                           Foreground="{DynamicResource ForgeTextMutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Syntax Reference (F1): searchable AsciiDoc cheat-sheet backed by
             the same catalog as completion. Enter inserts the snippet. -->
        <Border Name="SyntaxReferenceBackdrop"
                IsVisible="{Binding SyntaxReference.IsOpen}"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

        <Border Name="SyntaxReferenceOverlay"
                IsVisible="{Binding SyntaxReference.IsOpen}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,80,0,0"
                Width="560"
                MaxHeight="440"
                CornerRadius="12"
                Background="{DynamicResource ForgeBgSurfaceBrush}"
                BorderBrush="{DynamicResource ForgeBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 4 16 0 #40000000"
                Padding="0">
            <DockPanel>
                <TextBox Name="SyntaxReferenceFilter"
                         DockPanel.Dock="Top"
                         Watermark="{x:Static res:Strings.SearchAsciiDocSyntaxEnterInserts}"
                         Text="{Binding SyntaxReference.FilterText, Mode=TwoWay}"
                         Margin="8"
                         FontSize="14" />
                <ListBox Name="SyntaxReferenceList"
                         ItemsSource="{Binding SyntaxReference.FilteredItems}"
                         SelectedIndex="{Binding SyntaxReference.SelectedIndex, Mode=TwoWay}"
                         MaxHeight="340"
                         Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="assist:AssistItem">
                            <StackPanel Margin="8,4" Spacing="1">
                                <TextBlock Text="{Binding Label}" FontSize="12.5" />
                                <TextBlock Text="{Binding Description}"
                                           Foreground="{DynamicResource ForgeTextMutedBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Panel>

</Window>
