<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ascolotl.App.Views.PdfTitleDialog"
        Title="Ascolotl — PDF Title"
        SizeToContent="Height"
        Width="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontSize="12.5"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="34"
        Background="{DynamicResource ForgeBgBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="34"
                Background="{DynamicResource ForgeTitleBarBrush}">
            <TextBlock Text="{Binding $parent[Window].Title}"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="12" FontWeight="Medium"
                       Foreground="{DynamicResource ForgeTextBrush}" />
        </Border>

        <StackPanel Spacing="12" Margin="24"
                    TextElement.Foreground="{DynamicResource ForgeTextBrush}">
            <TextBlock Text="Title stored in the PDF's document properties:"
                       Foreground="{DynamicResource ForgeTextMutedBrush}" />

            <TextBox x:Name="TitleBox"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     MaxHeight="120" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,8,0,0">
                <Button Content="Export"
                        Classes="dialog primary"
                        Click="OnExportClick"
                        IsDefault="True"
                        MinWidth="90" />
                <Button Content="Cancel"
                        Classes="dialog"
                        Click="OnCancelClick"
                        IsCancel="True"
                        MinWidth="90" />
            </StackPanel>
        </StackPanel>
    </DockPanel>

</Window>
