<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ascolotl.App.Views.PreviewView">

    <Panel Background="{DynamicResource ForgeBgBrush}">
        <!-- No ScrollViewer padding: Avalonia subtracts its vertical padding
             from the scroll extent (clipping the last line at max scroll) and
             measures the content without its horizontal padding (so a paragraph
             laid out 40px too wide was clipped on both sides). The insets are a
             margin on the host and a bottom spacer in the panel instead, which
             measure and scroll correctly. -->
        <!-- No focus frame: around the whole page it reads as a border; the status bar says the page has the keyboard. -->
        <ScrollViewer x:Name="PreviewScroll"
                      Focusable="True"
                      FocusAdorner="{x:Null}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <!-- No clip of its own: the block outline reaches past the page edge. -->
            <ContentControl x:Name="PreviewHost"
                            ClipToBounds="False"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Margin="20,16,20,0" />
        </ScrollViewer>

        <!-- Find on the page (Ctrl+F): the matches are marked in the rendered text. -->
        <Border x:Name="FindBar"
                IsVisible="False"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,24,0"
                Padding="6"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource ForgeBorderBrush}"
                Background="{DynamicResource ForgeBgSurfaceBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="FindBox" Width="200" />
                <TextBlock x:Name="FindCount" VerticalAlignment="Center" MinWidth="64"
                           Foreground="{DynamicResource ForgeTextMutedBrush}" />
                <Button x:Name="FindPreviousButton" Content="↑" />
                <Button x:Name="FindNextButton" Content="↓" />
                <Button x:Name="FindCloseButton" Content="✕" />
            </StackPanel>
        </Border>

        <!-- Error overlay — shown instead of preview on render error -->
        <Border x:Name="StatusOverlay"
                IsVisible="False"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="24,16"
                Margin="16"
                CornerRadius="6"
                Background="{DynamicResource ForgeAccentDarkBrush}">
            <TextBlock x:Name="StatusText"
                       Foreground="White"
                       TextWrapping="Wrap"
                       FontSize="13" />
        </Border>
    </Panel>

</UserControl>
