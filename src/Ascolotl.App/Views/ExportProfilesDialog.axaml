<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Ascolotl.Core.Resources"
        x:Class="Ascolotl.App.Views.ExportProfilesDialog"
        Title="{x:Static res:Strings.AscolotlExportProfiles}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        MinWidth="500"
        FontSize="12.5"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="34"
        Background="{DynamicResource ForgeBgBrush}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="34"
                Background="{DynamicResource ForgeTitleBarBrush}">
            <TextBlock Text="{Binding $parent[Window].Title}"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       FontSize="12" FontWeight="Medium"
                       Foreground="{DynamicResource ForgeTextBrush}" />
        </Border>

        <Grid Margin="16" RowDefinitions="*,Auto" ColumnDefinitions="170,12,*"
              TextElement.Foreground="{DynamicResource ForgeTextBrush}">

            <!-- Profile list -->
            <DockPanel Grid.Row="0" Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <Button Name="AddButton" Content="+" Classes="dialog" MinWidth="32"
                            ToolTip.Tip="{x:Static res:Strings.AddProfile}"
                            AutomationProperties.Name="{x:Static res:Strings.AddProfile}" />
                    <Button Name="RemoveButton" Content="−" Classes="dialog" MinWidth="32"
                            ToolTip.Tip="{x:Static res:Strings.RemoveSelectedProfile}"
                            AutomationProperties.Name="{x:Static res:Strings.RemoveSelectedProfile}" />
                </StackPanel>
                <ListBox Name="ProfileList" MinHeight="180" MaxHeight="260"
                         Background="{DynamicResource ForgeBgDeepBrush}" />
            </DockPanel>

            <!-- Selected profile fields -->
            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="10" MinWidth="260">
                <StackPanel Spacing="4">
                    <TextBlock Name="NameLabel" Text="{x:Static res:Strings.Name}" FontSize="11"
                               Foreground="{DynamicResource ForgeTextMutedBrush}" />
                    <TextBox Name="NameBox" AutomationProperties.LabeledBy="{Binding #NameLabel}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Name="FormatLabel" Text="{x:Static res:Strings.Format}" FontSize="11"
                               Foreground="{DynamicResource ForgeTextMutedBrush}" />
                    <ComboBox Name="FormatBox" HorizontalAlignment="Stretch" AutomationProperties.LabeledBy="{Binding #FormatLabel}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Name="ThemeLabel" Text="{x:Static res:Strings.Theme}" FontSize="11"
                               ToolTip.Tip="{x:Static res:Strings.StylesHTMLAndPDFOutputConsistently}"
                               Foreground="{DynamicResource ForgeTextMutedBrush}" />
                    <ComboBox Name="ThemeBox" HorizontalAlignment="Stretch" AutomationProperties.LabeledBy="{Binding #ThemeLabel}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Name="FolderLabel" Text="{x:Static res:Strings.OutputFolder}" FontSize="11"
                               Foreground="{DynamicResource ForgeTextMutedBrush}" />
                    <DockPanel>
                        <Button Name="BrowseButton" DockPanel.Dock="Right" Content="…"
                                Classes="dialog" MinWidth="32" Margin="6,0,0,0"
                                ToolTip.Tip="{x:Static res:Strings.DialogChooseOutputFolder}"
                                AutomationProperties.Name="{x:Static res:Strings.DialogChooseOutputFolder}" />
                        <TextBox Name="FolderBox" AutomationProperties.LabeledBy="{Binding #FolderLabel}"
                                 Watermark="{x:Static res:Strings.EmptyNextToTheDocument}" />
                    </DockPanel>
                </StackPanel>
                <TextBlock Name="NoSelectionHint"
                           Text="{x:Static res:Strings.AddAProfileToGetOne}"
                           FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource ForgeTextMutedBrush}" />
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="{x:Static res:Strings.Close}" Classes="dialog primary"
                        Click="OnCloseClick" IsDefault="True" IsCancel="True" MinWidth="72" />
            </StackPanel>
        </Grid>
    </DockPanel>

</Window>
