<!-- The application menus (File, Import, Export, View, Style), defined once and
     built twice: inside the hamburger button and as the menu bar. The window shows
     one set or the other; nothing is moved between them at runtime. -->
<MenuItem xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Ascolotl.Core.Resources"
          xmlns:vm="using:Ascolotl.Core.ViewModels"
          xmlns:models="using:Ascolotl.Core.Models"
          xmlns:views="using:Ascolotl.App.Views"
          x:Class="Ascolotl.App.Views.AppMenus"
          x:DataType="vm:MainWindowViewModel">
    <MenuItem Header="{x:Static res:Strings.File}">
        <MenuItem Header="{x:Static res:Strings.New}"
                  Command="{Binding NewDocumentCommand}"
                  InputGesture="Ctrl+N" />
        <MenuItem Header="{x:Static res:Strings.Open}"
                  Command="{Binding OpenDocumentCommand}"
                  InputGesture="Ctrl+O" />
        <MenuItem Header="{x:Static res:Strings.OpenFolder}"
                  Command="{Binding OpenFolderCommand}"
                  InputGesture="Ctrl+Shift+O" />
        <MenuItem Header="{x:Static res:Strings.CloseFolder}"
                  Command="{Binding CloseFolderCommand}"
                  IsVisible="{Binding HasProject}" />
        <MenuItem Header="{x:Static res:Strings.RecentFiles}" Name="RecentFilesMenu" />
        <MenuItem Header="{x:Static res:Strings.ReopenClosedTab}"
                  Command="{Binding ReopenClosedTabCommand}"
                  InputGesture="Ctrl+Shift+T" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.Save}"
                  Command="{Binding SaveDocumentCommand}"
                  InputGesture="Ctrl+S" />
        <MenuItem Header="{x:Static res:Strings.SaveAs}"
                  Command="{Binding SaveDocumentAsCommand}"
                  InputGesture="Ctrl+Shift+S" />
        <MenuItem Header="{x:Static res:Strings.SaveAll}"
                  Command="{Binding SaveAllCommand}"
                  InputGesture="Ctrl+Alt+S" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.CloseTab}"
                  Command="{Binding CloseTabCommand}"
                  InputGesture="Ctrl+W" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.Exit}"
                  Click="OnExitClick" />
    </MenuItem>
    <MenuItem Header="{x:Static res:Strings.Import}">
        <MenuItem Header="{x:Static res:Strings.WordDocument}"
                  Command="{Binding ImportCommand}"
                  CommandParameter="{x:Static models:ImportFormat.Word}"
                  ToolTip.Tip="{x:Static res:Strings.ConvertADocxToAsciiDocImages}" />
        <MenuItem Header="{x:Static res:Strings.Markdown}"
                  Command="{Binding ImportCommand}"
                  CommandParameter="{x:Static models:ImportFormat.Markdown}" />
        <MenuItem Header="{x:Static res:Strings.HTML}"
                  Command="{Binding ImportCommand}"
                  CommandParameter="{x:Static models:ImportFormat.Html}" />
        <MenuItem Header="{x:Static res:Strings.MenuImportPdf}"
                  Command="{Binding ImportCommand}"
                  CommandParameter="{x:Static models:ImportFormat.Pdf}"
                  ToolTip.Tip="{x:Static res:Strings.RecoverHeadingsTextTablesAndNotes}" />
        <MenuItem Header="{x:Static res:Strings.PlainText}"
                  Command="{Binding ImportCommand}"
                  CommandParameter="{x:Static models:ImportFormat.PlainText}" />
    </MenuItem>
    <MenuItem x:Name="ExportMenu" Header="{x:Static res:Strings.Export}">
        <!-- Export-profile items are inserted at the
             top in code-behind (RebuildExportMenu). -->
        <MenuItem Header="{x:Static res:Strings.MenuExportPdf}"
                  Command="{Binding ExportCommand}"
                  CommandParameter="{x:Static models:ExportFormat.Pdf}"
                  InputGesture="Ctrl+E" />
        <MenuItem Header="{x:Static res:Strings.PDFLandscape}"
                  Command="{Binding ExportCommand}"
                  CommandParameter="{x:Static models:ExportFormat.PdfLandscape}" />
        <MenuItem Header="{x:Static res:Strings.HTML}"
                  Command="{Binding ExportCommand}"
                  CommandParameter="{x:Static models:ExportFormat.Html}" />
        <MenuItem Header="{x:Static res:Strings.DocBook}"
                  Command="{Binding ExportCommand}"
                  CommandParameter="{x:Static models:ExportFormat.DocBook}" />
        <MenuItem Header="{x:Static res:Strings.EPUB}"
                  Command="{Binding ExportCommand}"
                  CommandParameter="{x:Static models:ExportFormat.Epub}" />
        <MenuItem Header="{x:Static res:Strings.Website}"
                  Command="{Binding ExportWebsiteCommand}"
                  IsVisible="{Binding HasProject}"
                  ToolTip.Tip="{x:Static res:Strings.ExportTheWholeProjectFolderAs}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.ManageProfiles}"
                  Name="ManageExportProfilesItem" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.PDFTitle}">
            <MenuItem Header="{x:Static res:Strings.FullTitle}"
                      Command="{Binding SetPdfTitleRuleCommand}"
                      CommandParameter="{x:Static models:PdfTitleRule.FullTitle}"
                      ToggleType="Radio"
                      IsChecked="{Binding IsPdfTitleFull, Mode=OneWay}" />
            <MenuItem Header="{x:Static res:Strings.UpToFirstColon}"
                      Command="{Binding SetPdfTitleRuleCommand}"
                      CommandParameter="{x:Static models:PdfTitleRule.UpToFirstColon}"
                      ToggleType="Radio"
                      IsChecked="{Binding IsPdfTitleUpToColon, Mode=OneWay}" />
            <Separator />
            <MenuItem Header="{x:Static res:Strings.EditBeforeEachPDFExport}"
                      Command="{Binding ToggleAskPdfTitleCommand}"
                      ToggleType="CheckBox"
                      IsChecked="{Binding AskPdfTitle, Mode=OneWay}" />
        </MenuItem>
        <MenuItem Header="{x:Static res:Strings.AccessiblePdfMenu}"
                  Command="{Binding ToggleAccessiblePdfCommand}"
                  ToggleType="CheckBox"
                  IsChecked="{Binding AccessiblePdf, Mode=OneWay}"
                  ToolTip.Tip="{x:Static res:Strings.AccessiblePdfTip}" />
        <MenuItem Header="{x:Static res:Strings.WithAnotherStyle}">
            <MenuItem Header="{x:Static res:Strings.MenuExportPdf}"
                      Command="{Binding ExportWithStyleCommand}"
                      CommandParameter="{x:Static models:ExportFormat.Pdf}" />
            <MenuItem Header="{x:Static res:Strings.PDFLandscape}"
                      Command="{Binding ExportWithStyleCommand}"
                      CommandParameter="{x:Static models:ExportFormat.PdfLandscape}" />
            <MenuItem Header="{x:Static res:Strings.HTML}"
                      Command="{Binding ExportWithStyleCommand}"
                      CommandParameter="{x:Static models:ExportFormat.Html}" />
            <MenuItem Header="{x:Static res:Strings.EPUB}"
                      Command="{Binding ExportWithStyleCommand}"
                      CommandParameter="{x:Static models:ExportFormat.Epub}" />
        </MenuItem>
    </MenuItem>
    <MenuItem Header="{x:Static res:Strings.View}">
        <MenuItem Header="{x:Static res:Strings.SourceMode}"
                  Command="{Binding SetEditorModeCommand}"
                  CommandParameter="{x:Static models:EditorMode.Source}"
                  InputGesture="Ctrl+D1"
                  ToggleType="Radio"
                  IsChecked="{Binding IsSourceMode, Mode=OneWay}" />
        <MenuItem Header="{x:Static res:Strings.SplitMode}"
                  Command="{Binding SetEditorModeCommand}"
                  CommandParameter="{x:Static models:EditorMode.Split}"
                  InputGesture="Ctrl+D2"
                  ToggleType="Radio"
                  IsChecked="{Binding IsSplitMode, Mode=OneWay}" />
        <MenuItem Header="{x:Static res:Strings.WYSIWYGMode}"
                  Command="{Binding SetEditorModeCommand}"
                  CommandParameter="{x:Static models:EditorMode.Wysiwyg}"
                  InputGesture="Ctrl+D3"
                  ToggleType="Radio"
                  IsChecked="{Binding IsWysiwygMode, Mode=OneWay}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.ShowTitleTOC}"
                  Command="{Binding ToggleShowTitleAndTocCommand}"
                  ToggleType="CheckBox"
                  IsChecked="{Binding ShowTitleAndToc, Mode=OneWay}" />
        <MenuItem Header="{x:Static res:Strings.PagePreview}"
                  Command="{Binding TogglePagePreviewCommand}"
                  ToggleType="CheckBox"
                  IsChecked="{Binding PagePreview, Mode=OneWay}"
                  ToolTip.Tip="{x:Static res:Strings.FlowThePreviewIntoA4Pages}" />
        <MenuItem Header="{x:Static res:Strings.SyncScrolling}"
                  Command="{Binding ToggleSyncScrollingCommand}"
                  ToggleType="CheckBox"
                  IsChecked="{Binding SyncScrolling, Mode=OneWay}" />
        <MenuItem Header="{x:Static res:Strings.CheckSpelling}"
                  Command="{Binding ToggleCheckSpellingCommand}"
                  ToggleType="CheckBox"
                  IsChecked="{Binding CheckSpelling, Mode=OneWay}" />
        <MenuItem Header="{x:Static res:Strings.DiagramsMenu}">
            <MenuItem Header="{x:Static res:Strings.DiagramsOff}"
                      Command="{Binding SetDiagramModeCommand}"
                      CommandParameter="{x:Static models:DiagramMode.Off}"
                      ToggleType="Radio"
                      IsChecked="{Binding IsDiagramsOff, Mode=OneWay}"
                      ToolTip.Tip="{x:Static res:Strings.DiagramsOffTip}" />
            <MenuItem Header="{x:Static res:Strings.DiagramsLocal}"
                      Command="{Binding SetDiagramModeCommand}"
                      CommandParameter="{x:Static models:DiagramMode.LocalTools}"
                      ToggleType="Radio"
                      IsChecked="{Binding IsDiagramsLocal, Mode=OneWay}"
                      ToolTip.Tip="{x:Static res:Strings.DiagramsLocalTip}" />
            <MenuItem Header="{x:Static res:Strings.DiagramsKroki}"
                      Command="{Binding SetDiagramModeCommand}"
                      CommandParameter="{x:Static models:DiagramMode.Kroki}"
                      ToggleType="Radio"
                      IsChecked="{Binding IsDiagramsKroki, Mode=OneWay}"
                      ToolTip.Tip="{x:Static res:Strings.DiagramsKrokiTip}" />
        </MenuItem>
        <MenuItem Header="{x:Static res:Strings.EditorWordWrap}"
                  Command="{Binding ToggleEditorWordWrapCommand}"
                  ToggleType="CheckBox"
                  IsChecked="{Binding EditorWordWrap, Mode=OneWay}" />
        <MenuItem Header="{x:Static res:Strings.PreviewWordWrap}"
                  Command="{Binding TogglePreviewWordWrapCommand}"
                  ToggleType="CheckBox"
                  IsChecked="{Binding PreviewWordWrap, Mode=OneWay}" />
        <MenuItem Header="{x:Static res:Strings.ToggleOutline}"
                  Command="{Binding ToggleOutlinePaneCommand}"
                  InputGesture="Ctrl+B"
                  ToggleType="CheckBox"
                  IsChecked="{Binding ShowOutlinePane, Mode=OneWay}" />
        <MenuItem Header="{x:Static res:Strings.HamburgerMenu}"
                  Command="{Binding ToggleHamburgerMenuCommand}"
                  ToggleType="CheckBox"
                  IsChecked="{Binding HamburgerMenu, Mode=OneWay}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.ZoomIn}"
                  Command="{Binding ZoomInCommand}"
                  InputGesture="Ctrl+OemPlus" />
        <MenuItem Header="{x:Static res:Strings.ZoomOut}"
                  Command="{Binding ZoomOutCommand}"
                  InputGesture="Ctrl+OemMinus" />
        <MenuItem Header="{x:Static res:Strings.ResetZoom}"
                  Command="{Binding ZoomResetCommand}"
                  InputGesture="Ctrl+D0" />
        <MenuItem Header="{x:Static res:Strings.FitWidth}"
                  Command="{Binding TogglePreviewFitWidthCommand}"
                  ToggleType="CheckBox"
                  IsChecked="{Binding PreviewFitWidth, Mode=OneWay}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.ThemeLight}"
                  Command="{Binding SetThemeCommand}"
                  CommandParameter="{x:Static models:AppTheme.Light}"
                  ToggleType="Radio"
                  IsChecked="{Binding IsThemeLight, Mode=OneWay}" />
        <MenuItem Header="{x:Static res:Strings.ThemeDark}"
                  Command="{Binding SetThemeCommand}"
                  CommandParameter="{x:Static models:AppTheme.Dark}"
                  ToggleType="Radio"
                  IsChecked="{Binding IsThemeDark, Mode=OneWay}" />
        <MenuItem Header="{x:Static res:Strings.ThemeSystem}"
                  Command="{Binding SetThemeCommand}"
                  CommandParameter="{x:Static models:AppTheme.System}"
                  ToggleType="Radio"
                  IsChecked="{Binding IsThemeSystem, Mode=OneWay}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.LanguageMenu}">
            <MenuItem Header="{x:Static res:Strings.LanguageSystemDefault}"
                      Command="{Binding SetUiLanguageCommand}"
                      CommandParameter=""
                      ToggleType="Radio"
                      IsChecked="{Binding IsLanguageSystem, Mode=OneWay}" />
            <MenuItem Header="{x:Static res:Strings.LanguageEnglish}"
                      Command="{Binding SetUiLanguageCommand}"
                      CommandParameter="en"
                      ToggleType="Radio"
                      IsChecked="{Binding IsLanguageEnglish, Mode=OneWay}" />
            <MenuItem Header="{x:Static res:Strings.LanguageFrench}"
                      Command="{Binding SetUiLanguageCommand}"
                      CommandParameter="fr"
                      ToggleType="Radio"
                      IsChecked="{Binding IsLanguageFrench, Mode=OneWay}" />
            <MenuItem Header="{x:Static res:Strings.LanguageGerman}"
                      Command="{Binding SetUiLanguageCommand}"
                      CommandParameter="de"
                      ToggleType="Radio"
                      IsChecked="{Binding IsLanguageGerman, Mode=OneWay}" />
            <MenuItem Header="{x:Static res:Strings.LanguageItalian}"
                      Command="{Binding SetUiLanguageCommand}"
                      CommandParameter="it"
                      ToggleType="Radio"
                      IsChecked="{Binding IsLanguageItalian, Mode=OneWay}" />
            <MenuItem Header="{x:Static res:Strings.LanguageSpanish}"
                      Command="{Binding SetUiLanguageCommand}"
                      CommandParameter="es"
                      ToggleType="Radio"
                      IsChecked="{Binding IsLanguageSpanish, Mode=OneWay}" />
        </MenuItem>
    </MenuItem>
    <!-- Document style: an asciidoctor-pdf YAML theme used by
         the preview and by PDF/HTML/EPUB export. -->
    <MenuItem Header="{x:Static res:Strings.Style}">
        <MenuItem Header="{Binding StyleMenuHeader}" IsEnabled="False" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.LoadStyle}"
                  Command="{Binding LoadStyleCommand}" />
        <MenuItem Header="{x:Static res:Strings.UseBuiltInStyle}"
                  Command="{Binding ResetStyleCommand}"
                  IsEnabled="{Binding HasStyle}" />
    </MenuItem>
    <MenuItem Header="{x:Static res:Strings.Help}">
        <MenuItem Header="{x:Static res:Strings.MenuReportIssue}"
                  Tag="{x:Static views:AppLinks.Issues}"
                  Click="OnLinkClick" />
        <MenuItem Header="{x:Static res:Strings.AboutSponsorLink}"
                  Tag="{x:Static views:AppLinks.Sponsor}"
                  Click="OnLinkClick" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.MenuAbout}"
                  Command="{Binding ShowAboutCommand}" />
    </MenuItem>
</MenuItem>
