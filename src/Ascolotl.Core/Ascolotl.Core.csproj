<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="AdocNet.Parser" Version="1.0.45" />
    <PackageReference Include="AdocNet.Ast" Version="1.0.45" />
    <PackageReference Include="AdocNet.Core" Version="1.0.45" />
    <!-- MarkdownParser: Markdown documents parse to the same AST as AsciiDoc. -->
    <PackageReference Include="AdocNet.Importers" Version="1.0.45" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hunspell dictionaries from LibreOffice, inside the assembly: the single-file app
         carries them compressed. Their licenses are in the README files beside them. -->
    <EmbeddedResource Include="Dictionaries\*.aff;Dictionaries\*.dic" LogicalName="Dictionaries.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interface texts. Strings.<culture>.resx hold the translations; the
         typed Strings class is generated at build time. -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Ascolotl.Core.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ascolotl.Tests.Unit" />
  </ItemGroup>

</Project>
