<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest for the Microsoft Store. build-msix.ps1 fills the $...$ tokens:
     the identity values come from Partner Center (Product identity page). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="$IdentityName$"
    Publisher="$Publisher$"
    Version="$Version$"
    ProcessorArchitecture="$Architecture$" />

  <Properties>
    <DisplayName>Ascolotl</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A focused AsciiDoc editor with live preview and export to PDF, HTML, EPUB and DocBook.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Ascolotl" Executable="Ascolotl.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Ascolotl"
        Description="AsciiDoc editor with live preview and export"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Double-clicking these opens them in Ascolotl (the path arrives as an argument). -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="asciidoc">
            <uap:DisplayName>AsciiDoc document</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.adoc</uap:FileType>
              <uap:FileType>.asciidoc</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A desktop (Win32) app: runs with the user's normal rights. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
